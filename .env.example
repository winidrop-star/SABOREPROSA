# Copie este arquivo para ".env.local" (uso no seu computador) e/ou configure
# as mesmas variáveis nas "Environment Variables" do projeto na Vercel.

# Em supabase.com -> seu projeto -> Project Settings -> API
VITE_SUPABASE_URL=https://SEUPROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# PIN que o caixa digita para entrar no painel (troque antes de usar de verdade)
VITE_CAIXA_PIN=2707

# Trecho secreto da URL da área administrativa do site do cliente
# (ex: https://seusite.com.br/#ADMIN_SLUG) — troque por algo só seu
VITE_ADMIN_SLUG=saboreprosa-cozinha-4127
